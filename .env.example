# Copy to .env for local runs. NEVER commit .env.
# In GitHub Actions, add these as repository Secrets instead (Settings > Secrets and variables > Actions).

# --- Telegram (required to send) ---
# 1) Message @BotFather -> /newbot -> copy the token.
# 2) Send any message to your new bot, then run: python -m stockbot chatid
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM providers (all have free tiers; set at least one) ---
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq key (fallback): https://console.groq.com/keys
GROQ_API_KEY=
# Optional paid fallback / final-summary model
OPENAI_API_KEY=

# Order providers are tried in. Remove any you do not use.
LLM_PROVIDER_ORDER=gemini,groq,openai

# Model names change often on free tiers. Run `python -m stockbot models` to list what your key can use.
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_MODEL_SMART=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_MODEL=gpt-4o-mini

# Where run state (seen items, thesis history) is stored
STATE_PATH=state/state.json
